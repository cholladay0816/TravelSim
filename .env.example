# Example environment variables for TravelSim
# Copy to .env and update before running in production

# OpenAI API key (required for /api endpoints that forward to OpenAI)
OPENAI_API_KEY=sk-REPLACE_ME

# Optional: Basic HTTP auth for API endpoints. If set, clients must use these credentials.
# API_BASIC_USER=admin
# API_BASIC_PASS=strongpassword

# Optional: comma-separated list of allowed origins for CORS. If empty, the server will echo the request Origin.
#ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Rate limiter settings (window in ms, max requests per window)
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_MAX=100

# Server port
PORT=3000
# Copy to .env and set your OpenAI API key
OPENAI_API_KEY=sk-your-key-here
PORT=3000
